# --- Source maps (dev-only; ~3.6 MB of the package) ------------------------
*.map

# --- Unused webfonts -------------------------------------------------------
# FontAwesome 4 leftovers. The plugin enqueues lib/resources/css/font-awesome5.css,
# which references only fa-solid-900 / fa-regular-400 / fa-brands-400. Nothing in
# any shipped CSS, JS or PHP references these. ~1.0 MB.
lib/resources/fonts/fontawesome-webfont.*
lib/resources/fonts/FontAwesome.otf
# Dead delivery formats. Every @font-face here lists eot first (IE-only, EOL June
# 2022) and svg last (dropped from Chrome and Safari years ago); browsers download
# only the first format they support, which is woff2. ~2.5 MB.
# NOTE: do NOT add *.ttf — fonticonpicker.base-theme.react.css lists ttf FIRST, so
# fontIconPicker.ttf is actually fetched.
lib/resources/fonts/*.eot
lib/resources/fonts/*.svg

# --- Repository docs, not plugin docs --------------------------------------
README.md
compatibility-report.md
.wordpress-org

# --- OS / editor cruft and stray artefacts ---------------------------------
.DS_Store
Thumbs.db
.env
.env.*
*.log
*.sql
*.tar.gz
*.zip
