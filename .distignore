# Files and folders that must not end up in the WordPress.org distribution.
#
# `wp dist-archive` turns each line into a `zip --exclude '*/<line>'` pattern, and
# rewrites a line into `<line>/*` when it resolves to a directory at build time.
# Because zip's `*` also matches `/`, a bare name matches at any depth. Do NOT
# prefix entries with a leading slash — `/config` becomes `*//config` and matches
# nothing.

# --- Version control -------------------------------------------------------
.git
.gitignore
.gitattributes
.gitmodules
# The submodule `.git` entries are files, not directories, so the `.git` rule
# above (rewritten to `.git/*`) does not cover them.
lib/style-handler/.git
.github
.gitlab-ci.yml
.deployignore
.distignore

# --- CI / task runners -----------------------------------------------------
.circleci/config.yml
.travis.yml
bitbucket-pipelines.yml
behat.yml
dependencies.yml
wp-cli.local.yml
bin

